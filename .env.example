# --- Provider API 키 ---
# 어느 키가 필요한지는 아래 모델 식별자의 provider 접두사가 결정한다 (ADR-0019).
# 쓰지 않는 provider 의 키는 비워 둬도 된다.
#
# OpenAI key — eval 하니스 (chunk RAG / full-context) 와 apps/api (ingest 추출 +
# 노드 임베딩) 양쪽이 공유한다. 기본 모델 식별자가 openai/* 이므로 기본 경로엔 필수.
OPENAI_API_KEY=
# Anthropic key — ARCHE_API_LLM_MODEL 을 anthropic/* 로 바꿀 때만 필요.
# ANTHROPIC_API_KEY=
# (키 없는 대안) ARCHE_API_LLM_MODEL 을 claude-code/* 로 두면 머신에 설치된
# Claude Code(`claude`) 의 구독 인증으로 추출한다 — 별도 API 키 불필요. 단 텍스트
# 전용(이미지/PDF 페이지 미지원)이고 raw API 보다 호출 오버헤드가 크다 (로컬 직접
# 사용용). 임베딩은 별도라 openai/* 또는 voyage/* 키가 여전히 필요하다.
# Voyage key — ARCHE_API_EMBEDDING_MODEL 을 voyage/* 로 바꿀 때만 필요
# (Anthropic 은 임베딩 API 가 없어 임베딩 짝으로 Voyage 를 쓴다).
# VOYAGE_API_KEY=

# Neo4j password — docker compose 의 NEO4J_AUTH 와 NEO4J_PASSWORD 양쪽에 주입.
# 로컬 / 운영 환경에 따라 충분히 강한 값으로 교체.
NEO4J_PASSWORD=arche

# (선택) 모델 식별자 오버라이드. `provider/model` 형식이며 접두사로 어댑터를 고른다.
# 기본값은 코드에 고정돼 있다. provider 를 바꾸면 그 provider 의 키도 채워야 한다.
#   LLM 추출:   openai/gpt-4.1 | anthropic/claude-sonnet-4-5 | claude-code/claude-sonnet-4-5
#   임베딩:     openai/text-embedding-3-small | voyage/voyage-3
# 임베딩 모델을 바꾸면 출력 차원이 달라질 수 있다 — ARCHE_API_EMBEDDING_DIMENSION 을
# 맞추고 (예: voyage-3 = 1024) Neo4j 벡터 인덱스를 재생성해야 한다.
# ARCHE_EVAL_LLM_MODEL=openai/gpt-4.1
# ARCHE_EVAL_EMBEDDING_MODEL=openai/text-embedding-3-small
# ARCHE_API_LLM_MODEL=openai/gpt-4.1
# ARCHE_API_EMBEDDING_MODEL=openai/text-embedding-3-small
# ARCHE_API_EMBEDDING_DIMENSION=1536
