# OpenAI API key — eval 하니스 (chunk RAG / full-context) 와 apps/api (ingest 추출
# + 노드 임베딩) 양쪽이 공유한다.
OPENAI_API_KEY=

# Neo4j password — docker compose 의 NEO4J_AUTH 와 NEO4J_PASSWORD 양쪽에 주입.
# 로컬 / 운영 환경에 따라 충분히 강한 값으로 교체.
NEO4J_PASSWORD=arche

# (선택) baseline 모델 식별자를 오버라이드. 기본값은 코드에 박혀 있다.
# ARCHE_EVAL_LLM_MODEL=openai/gpt-4.1
# ARCHE_EVAL_EMBEDDING_MODEL=openai/text-embedding-3-small
# ARCHE_API_LLM_MODEL=openai/gpt-4.1
# ARCHE_API_EMBEDDING_MODEL=openai/text-embedding-3-small
