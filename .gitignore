# Local agent state — agents/ 는 팀 공통으로 commit, 나머지(settings.local.json, worktrees/, …)는 로컬 전용
.claude/*
!.claude/agents/
!.claude/agents/**

# uv
.uv-cache/

# Eval run outputs — 측정 산출물은 별도 트래킹 (commit 하지 않음)
eval/runs/

# Eval 대용량 원본 데이터 — 재현 가능 (다운로드/파생). 코퍼스 텍스트와 raw 데이터는
# commit 하지 않고 questions/answer_key 만 트래킹.
eval/datasets/*/raw/
eval/datasets/medhop-2026-06-22/corpus/
eval/external/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Env / secrets
.env
.env.*
!.env.example

# Docker
.docker-data/

# Local config (user overrides)
config.local.yaml

# HuggingFace cache (TEI)
.hf-cache/

# Brainstorming mockups (Visual Companion)
.superpowers/

# graphify — 그래프 산출물·캐시는 commit, 머신 로컬 경로 마커만 제외
graphify-out/.graphify_python
graphify-out/.graphify_root

# ADR-0010 extraction cache
.opentology-cache/

